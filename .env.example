# default env = "dev", "prod" for production
ENV="dev"

# text messaging service mode, "dev" for development, "prod" for production, dev mode sends text to me
TEXTING_SERVICE_MODE="dev"

# frontend URL for CORS and other purposes, default is localhost for development, change to production URL when deploying
FRONTEND_URL="http://localhost:5173"

# internal API key for internal endpoints
INTERNAL_API_KEY=

# supabase database connection string and URL
DB_CONNECTION_STRING=
DB_URL=
DB_PUBLISHABLE_KEY=

# supabase auth credentials for internal get_token dev utility
TOKEN_USER=
TOKEN_PASSWORD=

# google api key for books
GOOGLE_API_KEY=

# textbelt API Key and phone numbers for water texting service
TEXTBELT_API_KEY=
ELIE_NUMBER=
HELAINA_NUMBER=
